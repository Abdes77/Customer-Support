# Environment variables for the home-services reply bot.
#
# GENERATED from packages/core/src/env/spec.ts by "pnpm env:example". Do not edit by hand.
# Copy to .env.local for local development. Never commit real values.
# docs/HUMAN_TODO.md says where to get each value.
#
# [production] the product cannot run without it
# [feature]    needed only for that channel or integration
# [optional]   has a default or is a convenience

############################################################################################
# Application
############################################################################################

# [production] Public origin of the deployment. Used for webhook callbacks, OAuth redirects
# and links in alerts.
APP_URL=http://localhost:3000

# [production] Same origin as APP_URL, exposed to the browser and the embeddable widget.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# [optional] Minimum level written by the structured logger.
LOG_LEVEL=info

############################################################################################
# Supabase and PostgreSQL (C1)
############################################################################################

# [production] Supabase project URL (Project Settings, API).
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# [production] Supabase anon (publishable) key. Safe in the browser: row-level security
# applies.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# [production] [secret] Supabase service-role key. Bypasses row-level security: server only.
SUPABASE_SERVICE_ROLE_KEY=

# [feature] [secret] Supabase JWT secret, used to mint short-lived Realtime tokens for
# widget visitors.
SUPABASE_JWT_SECRET=

# [production] [secret] PostgreSQL connection string for the app at runtime (Supabase
# pooler, transaction mode).
DATABASE_URL=postgresql://hsrb:hsrb@127.0.0.1:5432/hsrb_dev

# [production] [secret] Direct PostgreSQL connection string, used only to run migrations.
DATABASE_URL_DIRECT=postgresql://hsrb:hsrb@127.0.0.1:5432/hsrb_dev

# [optional] [secret] Database that tests may create, migrate and wipe. Never point it at
# real data.
TEST_DATABASE_URL=postgresql://hsrb:hsrb@127.0.0.1:5432/hsrb_test

# [optional] Connections each server instance may open to PostgreSQL. Keep it small on
# serverless.
DATABASE_POOL_MAX=5

# [optional] [secret] Password that pnpm db:seed gives the demo users (at least 12
# characters). Required to seed a Supabase database; a local database falls back to the
# documented demo password.
SEED_USER_PASSWORD=

# [optional] Private Storage bucket for customer photos and other attachments.
SUPABASE_STORAGE_BUCKET=attachments

############################################################################################
# Application-layer secrets (C1, C8)
############################################################################################

# [production] [secret] AES-256-GCM key that encrypts stored OAuth tokens, page tokens and
# SMTP passwords. Generate with: openssl rand -base64 32
CREDENTIALS_ENCRYPTION_KEY=

# [optional] Label stored with each ciphertext so keys can be rotated.
CREDENTIALS_ENCRYPTION_KEY_ID=k1

# [optional] [secret] Retired keys still needed to decrypt old rows during rotation, as
# id:base64key pairs separated by commas.
CREDENTIALS_ENCRYPTION_OLD_KEYS=

# [optional] [secret] Local development and CI only: switches on the built-in sign-in that
# stands in for Supabase Auth when no Supabase project is configured, and signs its session
# cookie (at least 32 characters). Ignored on Vercel. Never set it in production.
LOCAL_AUTH_SECRET=

# [feature] [secret] Signs website-widget visitor sessions (at least 32 characters).
# Generate with: openssl rand -base64 48
WIDGET_SESSION_SECRET=

# [optional] [secret] Signs webhooks of the built-in test channel (dev chat page, onboarding
# test chat). At least 32 characters. Locally a random per-process secret is used when it is
# empty; a hosted deployment without it has no test channel. Generate with: openssl rand
# -base64 48
TEST_CHANNEL_SECRET=

############################################################################################
# Claude API (C4, C6, C7)
############################################################################################

# [production] [secret] Claude API key. The workspace needs 30-day data retention for
# claude-fable-5-2. Without it, tests and evals run against a mocked model.
ANTHROPIC_API_KEY=

# [optional] Override the Claude API endpoint (proxies and tests only).
ANTHROPIC_BASE_URL=

# [optional] Which model answers. live: the Claude API (needs ANTHROPIC_API_KEY). offline: a
# built-in rule-based stand-in for local development and end-to-end tests; refused on
# Vercel. Default: live when the key is set, otherwise offline on a developer machine.
AI_MODEL_MODE=

############################################################################################
# Inngest (C3)
############################################################################################

# [production] [secret] Inngest event key, used to send events.
INNGEST_EVENT_KEY=

# [production] [secret] Inngest signing key, used to authenticate calls to /api/inngest.
INNGEST_SIGNING_KEY=

# [optional] [secret] Previous signing key, accepted during key rotation.
INNGEST_SIGNING_KEY_FALLBACK=

# [optional] Set to 1 to use the local Inngest dev server instead of Inngest Cloud. Ignored
# on Vercel production and preview deployments (dev mode does not check request signatures).
INNGEST_DEV=1

# [optional] URL of a self-run Inngest dev server, when it is not on the default port.
INNGEST_BASE_URL=

############################################################################################
# Meta: WhatsApp, Instagram, Messenger (C9, C10)
############################################################################################

# [feature] Meta app id (developers.facebook.com, App settings, Basic).
META_APP_ID=

# [feature] Same Meta app id, exposed to the browser for Embedded Signup and Facebook Login.
NEXT_PUBLIC_META_APP_ID=

# [feature] [secret] Meta app secret. Verifies webhook signatures and exchanges login codes.
META_APP_SECRET=

# [feature] [secret] Any random string; entered again in the Meta webhook configuration
# screen.
META_WEBHOOK_VERIFY_TOKEN=

# [optional] Graph API version used for every Meta call (v27.0 when unset, the version
# Meta's docs used in November 2026). Check Meta's changelog before raising it.
META_GRAPH_API_VERSION=v27.0

# [feature] Configuration id of the WhatsApp Embedded Signup flow (Facebook Login for
# Business).
META_WHATSAPP_SIGNUP_CONFIG_ID=

# [feature] Configuration id of the Facebook Login for Business flow that connects Pages and
# Instagram accounts.
META_LOGIN_CONFIG_ID=

# [optional] Live check only: phone number id of the Meta test WhatsApp number.
META_TEST_WHATSAPP_PHONE_NUMBER_ID=

# [optional] [secret] Live check only: access token for the test WhatsApp number.
META_TEST_WHATSAPP_ACCESS_TOKEN=

# [optional] Live check only: WhatsApp Business Account id of the test number (WhatsApp
# Manager, or the app's API Setup page).
META_TEST_WHATSAPP_BUSINESS_ACCOUNT_ID=

# [optional] Live check only: your own phone number in E.164, registered as a test
# recipient.
META_TEST_WHATSAPP_RECIPIENT=

# [optional] Live check only: id of the test Facebook Page.
META_TEST_PAGE_ID=

# [optional] [secret] Live check only: Page access token of the test Page.
META_TEST_PAGE_ACCESS_TOKEN=

# [optional] Live check only: id of the test Instagram professional account.
META_TEST_INSTAGRAM_ACCOUNT_ID=

############################################################################################
# Voice message transcription (C9)
############################################################################################

# [feature] [secret] Deepgram API key (console.deepgram.com). Transcribes WhatsApp voice
# messages for businesses whose setting `channels.whatsapp.voice_messages` is "transcribe";
# without it the bot asks the customer to type.
DEEPGRAM_API_KEY=

############################################################################################
# Google: Gmail and Calendar (C11, C12)
############################################################################################

# [feature] Google OAuth client id (Gmail and Google Calendar).
GOOGLE_CLIENT_ID=

# [feature] [secret] Google OAuth client secret.
GOOGLE_CLIENT_SECRET=

# [feature] Pub/Sub topic that Gmail push notifications are published to.
GOOGLE_PUBSUB_TOPIC=projects/your-project/topics/gmail-push

# [feature] Service account that signs Pub/Sub push requests; the Gmail webhook rejects any
# other sender.
GOOGLE_PUBSUB_PUSH_SERVICE_ACCOUNT=

# [optional] Audience of the Pub/Sub push token, as set on the push subscription. Default:
# <APP_URL>/api/webhooks/email/gmail (Pub/Sub's default audience is the push endpoint).
GOOGLE_PUBSUB_PUSH_AUDIENCE=

############################################################################################
# Microsoft: Outlook mail and calendar (C11, C12)
############################################################################################

# [feature] Microsoft Entra application (client) id for Outlook mail and calendar.
MICROSOFT_CLIENT_ID=

# [feature] [secret] Microsoft Entra client secret.
MICROSOFT_CLIENT_SECRET=

# [optional] Entra tenant; "common" accepts work, school and personal accounts.
MICROSOFT_TENANT_ID=common

# [feature] [secret] Secret from which each Graph subscription's clientState is derived (one
# per inbox) and checked on every change notification. Generate with: openssl rand -base64
# 32
MICROSOFT_GRAPH_CLIENT_STATE=

############################################################################################
# Twilio: SMS and voice alerts (C13)
############################################################################################

# [feature] Twilio account SID.
TWILIO_ACCOUNT_SID=

# [feature] [secret] Twilio auth token. Also verifies Twilio webhook signatures.
TWILIO_AUTH_TOKEN=

# [feature] Twilio number in E.164 that sends alert SMS and places escalation calls.
TWILIO_FROM_NUMBER=+15555550100

# [optional] Optional Twilio Messaging Service to send SMS through instead of the bare
# number.
TWILIO_MESSAGING_SERVICE_SID=

############################################################################################
# Alert delivery by email and WhatsApp (C13)
############################################################################################

# [feature] From address for lead alerts and system email.
ALERT_EMAIL_FROM=alerts@example.com

# [feature] [secret] SMTP server that sends alert email, as
# smtp(s)://user:password@host:port.
ALERT_SMTP_URL=

# [feature] Phone number id of the agency's own WhatsApp number that sends alerts.
ALERT_WHATSAPP_PHONE_NUMBER_ID=

# [feature] [secret] System-user access token for the agency's alert WhatsApp number.
ALERT_WHATSAPP_ACCESS_TOKEN=

# [feature] Name of the approved template the alert WhatsApp number sends (utility category,
# body with one parameter, for example "New alert: {{1}}").
ALERT_WHATSAPP_TEMPLATE=staff_alert

# [optional] Language code of the alert template.
ALERT_WHATSAPP_TEMPLATE_LANGUAGE=en_US

############################################################################################
# Calendly (C12)
############################################################################################

# [feature] Calendly OAuth client id.
CALENDLY_CLIENT_ID=

# [feature] [secret] Calendly OAuth client secret.
CALENDLY_CLIENT_SECRET=

# [feature] [secret] Signing key for Calendly webhook subscriptions.
CALENDLY_WEBHOOK_SIGNING_KEY=

############################################################################################
# CRM connectors (C14)
############################################################################################

# [feature] HubSpot public app client id.
HUBSPOT_CLIENT_ID=

# [feature] [secret] HubSpot public app client secret.
HUBSPOT_CLIENT_SECRET=

# [feature] GoHighLevel marketplace app client id.
GOHIGHLEVEL_CLIENT_ID=

# [feature] [secret] GoHighLevel marketplace app client secret.
GOHIGHLEVEL_CLIENT_SECRET=

# [feature] Jobber developer app client id.
JOBBER_CLIENT_ID=

# [feature] [secret] Jobber developer app client secret.
JOBBER_CLIENT_SECRET=

# [feature] Housecall Pro OAuth client id (partner apps; single companies use an API key).
HOUSECALL_PRO_CLIENT_ID=

# [feature] [secret] Housecall Pro OAuth client secret.
HOUSECALL_PRO_CLIENT_SECRET=

# [feature] [secret] ServiceTitan application key. Each business adds its own tenant id,
# client id and secret in the admin panel.
SERVICETITAN_APP_KEY=

# [optional] ServiceTitan API environment.
SERVICETITAN_ENVIRONMENT=integration

############################################################################################
# Observability (C17)
############################################################################################

# [feature] Sentry DSN for server-side errors.
SENTRY_DSN=

# [feature] Sentry DSN for browser errors (usually the same project).
NEXT_PUBLIC_SENTRY_DSN=

# [optional] [secret] Sentry auth token; uploads source maps during the Vercel build.
SENTRY_AUTH_TOKEN=

# [optional] Sentry organization slug.
SENTRY_ORG=

# [optional] Sentry project slug.
SENTRY_PROJECT=
